@echo off
setlocal

powershell -NoProfile -ExecutionPolicy Bypass -Command "$root = [IO.Path]::GetFullPath('%~dp0'); $scripts = @((Join-Path $root 'main.py'), (Join-Path $root 'fusion.py'), (Join-Path $root 'speech_simulator.py')); $ppilotPath = Join-Path $root 'ppilot5_3.3\ppilot5.exe'; $sraPath = Join-Path $root 'sra5\sra5\sra5.exe'; $found = $false; foreach ($process in (Get-CimInstance Win32_Process)) { $match = $false; if ($process.Name -ieq 'python.exe' -and $process.CommandLine) { foreach ($script in $scripts) { if ($process.CommandLine.IndexOf($script, [StringComparison]::OrdinalIgnoreCase) -ge 0) { $match = $true; break } } }; if (($process.Name -ieq 'ppilot5.exe' -and $process.ExecutablePath -and $process.ExecutablePath.Equals($ppilotPath, [StringComparison]::OrdinalIgnoreCase)) -or ($process.Name -ieq 'sra5.exe' -and $process.ExecutablePath -and $process.ExecutablePath.Equals($sraPath, [StringComparison]::OrdinalIgnoreCase))) { $match = $true }; if ($match) { $found = $true; Write-Host ('Stopping {0} (PID {1})' -f $process.Name, $process.ProcessId); Stop-Process -Id $process.ProcessId -Force -ErrorAction SilentlyContinue } }; if (-not $found) { Write-Host 'No running TP_IHM components found.' }"